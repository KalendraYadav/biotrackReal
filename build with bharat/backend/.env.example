# Server configuration
PORT=5000
NODE_ENV=development

# Database connections
# DATABASE_URL: Runtime connection (Supabase transaction pooler port 6543 in production, or Docker PostgreSQL port 5435 locally)
DATABASE_URL="postgresql://postgres:password@localhost:5435/nidusclean?schema=public"

# DIRECT_URL: Migration connection (Supabase direct session connection port 5432 for Prisma migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=public"

# Connection pool settings (conservative sizing for transaction pooler / multi-instance setups)
DB_POOL_MAX=5

# Cross-Origin Resource Sharing (comma-separated origins)
CORS_ORIGIN="http://localhost:5173,http://localhost:5000"

# Authentication (generate a secure random 64-char string for production)
JWT_SECRET="your_production_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# Maps / Geolocation (Optional)
GOOGLE_MAPS_API_KEY=""

# Supabase Storage Configuration (Evidence Private Bucket)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="your_supabase_secret_key_here"
SUPABASE_STORAGE_BUCKET="evidence"
